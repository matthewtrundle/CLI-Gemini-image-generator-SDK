# OpenRouter API Key for Gemini 2.5 Flash Image Preview
# Get your key at: https://openrouter.ai/keys
GEMINI_API_KEY=sk-or-v1-your_api_key_here

# Optional: Override default output directory
# OUTPUT_DIR=./public/images

# Optional: Override image dimensions
# IMAGE_WIDTH=1920
# IMAGE_HEIGHT=1080

# Optional: Override WebP quality (1-100)
# WEBP_QUALITY=85